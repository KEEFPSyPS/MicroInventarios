{
  "name": "microinventarios",
  "version": "1.0.0",
  "private": true,
  "description": "PWA de auditoría de recepción de mercancía.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test verificar-pasos.cjs",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore.rules.test.cjs\"",
    "serve": "npx --yes serve .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "build:sw": "node scripts/actualizar-version-sw.mjs",
    "iconos": "node generar-iconos.mjs"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
