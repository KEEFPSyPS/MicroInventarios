rules_version = '2';

/* ============================================================================
   Reglas de seguridad de Cloud Firestore — Microinventarios de recepción
   ----------------------------------------------------------------------------
   Principios aplicados (estándar internacional):
     · ISO/IEC 27001:2022 A.5.15 (control de acceso) y A.8.3 (restricción de acceso a la información)
     · OWASP ASVS 4.0 V4.1/V4.2 (control de acceso a nivel de función y de dato)
     · OWASP Top 10:2021 A01 (Broken Access Control) y A04 (Insecure Design)
     · NIST SP 800-53 AC-3 / AC-6 (acceso y mínimo privilegio)
     · COSO / ISA 315 para trazabilidad de evidencia de auditoría (no repudio)

   Modelo: DENEGAR TODO por defecto. Solo un usuario autenticado con correo
   verificado puede leer las auditorías. CREAR sigue siendo solo para el propio
   autor. ACTUALIZAR lo puede hacer cualquier usuario activo (trabajo simultáneo
   en un mismo folio), pero SIN poder suplantar la identidad: uid, email del
   creador e id son INMUTABLES, y todo update ajeno debe declarar quién lo hizo
   (actualizadoPor == correo del token) y cuándo (actualizadoEn == request.time).
   BORRAR sigue reservado al dueño o a la lista de gerencia (no repudio de la
   evidencia).
   ============================================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Funciones auxiliares ---------- */

    /* ¿Hay sesión? */
    function autenticado() {
      return request.auth != null;
    }

    /* Correo verificado. Se exige para LEER y ESCRIBIR datos de negocio.
       Las cuentas creadas a mano en la consola nacen sin verificar, así que
       hay que habilitarles la verificación (ver README de despliegue). */
    function correoVerificado() {
      return request.auth != null
          && request.auth.token.email_verified == true;
    }

    /* Bloqueo de cuentas deshabilitadas desde la consola (token.custom = "disabled"). */
    function activo() {
      return correoVerificado()
          && (!('custom' in request.auth.token) || request.auth.token.custom != 'disabled');
    }

    /* Lista de correos con permiso de borrado sobre registros ajenos (gerencia).
       Se compara contra un correo no vacío: una cadena vacía nunca debe autorizar. */
    function esDeLaLista() {
      return request.auth.token.email != null
          && request.auth.token.email != ''
          && request.auth.token.email in [
        'c.moralesm1997@gmail.com'
      ];
    }

    /* El documento pertenece a quien lo creó. Nunca se confía en el cliente. */
    function esPropietario() {
      return resource.data.uid == request.auth.uid;
    }

    /* ---------- Validación de esquema de una auditoría ---------- */

    /* Partidas (hasta 70). Solo se exige una lista de 1 a 70 elementos: validar
       cada partida campo por campo rebasa el límite de ~1,000 expresiones por
       petición. La forma de cada partida la impone normalizar() en index.html.
       MAX_PARTIDAS en index.html debe ser igual a este 70. */
    function partidasValidas(ps) {
      return ps is list && ps.size() > 0 && ps.size() <= 70;
    }

    /* `linea` (Volkswagen/Chevrolet) y `encargado` son campos OPCIONALES.
       Motivo: la app ya no los captura (el responsable sale del token de sesión,
       guardado en `email`). Para no romper la compatibilidad se permiten TRES
       estados:
         · ausente  → documento NUEVO de la app actual (no se escribe el campo).
         · ''       → borrador guardado por una versión previa de la app.
         · válido   → documento VIEJO que sí traía el valor.
       Un valor PRESENTE pero inválido (p. ej. linea = 'Nissan') sigue denegado.
       `!(campo in data)` es la comprobación de ausencia en el lenguaje de reglas. */
    function lineaValida() {
      return !('linea' in request.resource.data)
          || request.resource.data.linea in ['', 'Volkswagen', 'Chevrolet'];
    }
    function encargadoValido() {
      return !('encargado' in request.resource.data)
          || (request.resource.data.encargado is string
              && request.resource.data.encargado.size() <= 120);
    }

    /* Campos NUEVOS del trabajo simultáneo (todos OPCIONALES para no romper la
       compatibilidad con documentos viejos ni con una app antigua en caché):
         · rev           → contador de revisión (entero >= 1) que incrementa la
                           transacción del cliente al fusionar.
         · actualizadoPor→ correo de quien hizo el último cambio (<=120).
         · actualizadoEn→ marca de tiempo del servidor (request.time).
       `pid` viaja DENTRO de cada partida y se valida en partidaValida().
       Al ser opcionales, la app VIEJA (que no los envía) sigue actualizando su
       propio folio sin cambios. */
    function revValida() {
      return !('rev' in request.resource.data)
          || (request.resource.data.rev is int && request.resource.data.rev >= 1);
    }
    function actualizadoPorValido() {
      return !('actualizadoPor' in request.resource.data)
          || (request.resource.data.actualizadoPor is string
              && request.resource.data.actualizadoPor.size() <= 120);
    }
    function actualizadoEnValido() {
      return !('actualizadoEn' in request.resource.data)
          || request.resource.data.actualizadoEn == request.time;
    }

    /* Forma de UNA partida (DOCUMENTACIÓN, no se invoca): validar cada partida
       campo por campo rebasa el límite de ~1,000 expresiones por petición (por eso
       partidasValidas() solo comprueba que sea una lista de 1..70). La forma la
       garantiza normalizar() en app.js, incluido el `pid` (identificador estable
       para fusionar partida a partida), que es un texto de hasta 24 caracteres.
       Se deja escrita como referencia del contrato que el cliente debe cumplir:
         { pid?, codigo(1..60), desc(<=300), fact/recib/real/realPV/realBR (<=12) } */

    /* Límites de tamaño y coherencia de identidad.
       Se usa `let` (soportado en rules_version '2', máx. 10 bindings) para no
       repetir request.resource.data en cada línea. */
    function contenidoValido() {
      let d = request.resource.data;
      return partidasValidas(d.partidas)
          && lineaValida()
          && encargadoValido()
          && revValida()
          && actualizadoPorValido()
          && actualizadoEnValido()
          && d.paso is int && d.paso >= 1 && d.paso <= 6
          && d.fecha is string && d.fecha.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && d.folio is string && d.folio.size() <= 60
          && d.proveedor is string && d.proveedor.size() <= 120
          && d.verificador is string && d.verificador.size() <= 120
          && d.id is string && d.id.size() <= 60
          && d.creado is int && d.creado > 0
          && d.uid is string && d.uid.size() <= 128
          && d.email is string && d.email.size() <= 120;
    }

    /* Al CREAR, la identidad debe ser la del autor (no se puede crear a nombre
       de otro). */
    function autorValido() {
      return request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email;
    }

    /* En ACTUALIZAR, la identidad del creador es INMUTABLE: uid, email e id no
       pueden cambiar, y `creado` tampoco (anti-suplantación y no repudio). */
    function identidadIntacta() {
      return resource.data.uid   == request.resource.data.uid
          && resource.data.id    == request.resource.data.id
          && resource.data.email == request.resource.data.email
          && resource.data.creado == request.resource.data.creado;
    }

    /* ¿El que escribe es el DUEÑO del documento? Ya definido arriba
       (esPropietario()). Aquí solo se documenta el uso: el dueño puede
       actualizar sin declarar actualizadoPor, para no romper a la app antigua. */

    /* Todo update AJENO debe declarar quién lo hizo: actualizadoPor igual al
       correo del token. El dueño queda exento para no romper a la app antigua en
       caché, que no envía este campo. */
    function autorDelCambioValido() {
      return esPropietario()
          || ('actualizadoPor' in request.resource.data
              && request.resource.data.actualizadoPor == request.auth.token.email);
    }

    /* ================= Colección: auditorias ================= */

    match /auditorias/{auditoriaId} {
      /* LECTURA: cualquier miembro del personal con correo verificado. */
      allow read: if activo();

      /* CREACIÓN: solo el propio autor (no se crea a nombre de otro), con id del
         documento igual al del payload y esquema completo válido (los campos
         obligatorios son implícitos: si falta cualquiera, contenidoValido()
         falla al leerlo). */
      allow create: if activo()
                    && request.resource.data.id == auditoriaId
                    && autorValido()
                    && contenidoValido();

      /* ACTUALIZACIÓN: cualquier usuario activo (trabajo simultáneo en un mismo
         folio), pero sin poder tocar la identidad del creador (uid, email, id,
         creado son inmutables) y declarando quién hace el cambio
         (actualizadoPor == correo del token) en los updates ajenos. El dueño
         queda exento de declararlo para no romper a la app antigua en caché. */
      allow update: if activo()
                    && identidadIntacta()
                    && autorDelCambioValido()
                    && contenidoValido();

      /* BORRADO: solo el dueño. La gerencia puede borrar cualquier registro. */
      allow delete: if activo() && (esPropietario() || esDeLaLista());
    }

    /* ================= Bloqueo explícito del resto ================= */

    /* Cualquier ruta no declarada queda denegada (defensa en profundidad). */
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}